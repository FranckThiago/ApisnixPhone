diff --git a/CMakeLists.txt b/CMakeLists.txt
index 09e6b21..9a3c8ad 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -71,8 +71,8 @@ endif()
 
 set(CMAKE_INSTALL_PREFIX "${APPLICATION_OUTPUT_DIR}")
 
-set(LINPHONEAPP_APPLICATION_NAME "Linphone" CACHE STRING "Application name" )
-set(LINPHONEAPP_EXECUTABLE_NAME "linphone" CACHE STRING "Executable name" )
+set(LINPHONEAPP_APPLICATION_NAME "ApisnixPhone" CACHE STRING "Application name" )
+set(LINPHONEAPP_EXECUTABLE_NAME "apisnixphone" CACHE STRING "Executable name" )
 
 # Include application_info.cmake here as the LINPHONEAPP_APPLICATION_NAME variable must be known as it is set to the APPLICATION_NAME variable.
 include(Linphone/application_info.cmake)
@@ -176,10 +176,10 @@ add_option(OPTION_LIST ENABLE_TESTS "Build with testing binaries of SDK" OFF)
 add_option(OPTION_LIST ENABLE_TESTS_COMPONENTS "Build libbctoolbox-tester" OFF)
 add_option(OPTION_LIST ENABLE_TOOLS "Enable tools of SDK" OFF)
 add_option(OPTION_LIST ENABLE_UNIT_TESTS "Enable unit test of SDK." OFF)
-add_option(OPTION_LIST ENABLE_UPDATE_CHECK "Enable update check." ON)
+add_option(OPTION_LIST ENABLE_UPDATE_CHECK "Enable update check." OFF)
 add_option(OPTION_LIST ENABLE_VIDEO "Enable Video support." YES)
 add_option(OPTION_LIST ENABLE_WINDOWS_TOOLS_CHECK "Enable tools checks on Windows for auto install." OFF)
-add_option(OPTION_LIST ENABLE_CRASH_HANDLER "Enable Crash Handler" YES)
+add_option(OPTION_LIST ENABLE_CRASH_HANDLER "Enable Crash Handler" NO)
 
 add_cache(OPTION_LIST LINPHONE_SDK_MAKE_RELEASE_FILE_URL "Make a RELEASE file that work along check_version and use this URL" "")
 
diff --git a/Linphone/application_info.cmake b/Linphone/application_info.cmake
index b8e4f15..9559470 100644
--- a/Linphone/application_info.cmake
+++ b/Linphone/application_info.cmake
@@ -1,11 +1,11 @@
-set(APPLICATION_DESCRIPTION "A libre SIP client")
-set(APPLICATION_ID "com.belledonnecommunications.${LINPHONEAPP_EXECUTABLE_NAME}")
+set(APPLICATION_DESCRIPTION "Softphone SIP APISNIX, based on Linphone")
+set(APPLICATION_ID "com.apisnix.phone")
 set(APPLICATION_NAME ${LINPHONEAPP_APPLICATION_NAME})
-set(APPLICATION_URL "https://www.linphone.org")
-set(APPLICATION_VENDOR "Belledonne Communications")
+set(APPLICATION_URL "https://apisnix.com")
+set(APPLICATION_VENDOR "APISNIX")
 set(APPLICATION_LICENCE "GNU General Public License V3")
 set(APPLICATION_LICENCE_URL "https://www.gnu.org/licenses/gpl-3.0.html")
-set(APPLICATION_START_LICENCE "2010")
+set(APPLICATION_START_LICENCE "2026")
 set(APPLICATION_SEMVER ${LINPHONEAPP_VERSION})
 
 set(EXECUTABLE_NAME ${LINPHONEAPP_EXECUTABLE_NAME})
diff --git a/Linphone/data/config/linphonerc-factory b/Linphone/data/config/linphonerc-factory
index e518d3f..108d0ed 100644
--- a/Linphone/data/config/linphonerc-factory
+++ b/Linphone/data/config/linphonerc-factory
@@ -1,9 +1,7 @@
 [account_creator]
 backend=1
 # 1 means FlexiAPI, 0 is XMLRPC
-url=https://subscribe.linphone.org/api/
-# replace above URL by https://staging-subscribe.linphone.org/api/ for testing
-# url=https://flexisip-staging-master.linphone.org/api/
+url=
 
 [alerts]
 alerts_enabled=1
@@ -43,22 +41,26 @@ chat_messages_aggregation_delay=1000
 guess_hostname=1
 ping_with_options=0
 register_only_when_network_is_up=1
-rls_uri=sips:rls@sip.linphone.org
+rls_uri=
 update_presence_model_timestamp_before_publish_expires_refresh=1
 use_cpim=1
 zrtp_key_agreements_suites=MS_ZRTP_KEY_AGREEMENT_K255_MLK512,MS_ZRTP_KEY_AGREEMENT_K255_KYB512
 
 [sound]
-#remove this property for any application that is not Linphone public version itself
-ec_calibrator_cool_tones=1
 ec_filter=MSWebRTCAEC
 noise_suppression=0
 
 [ui]
 assistant_supports_phone_numbers/readonly=0
 use_qrcode=0
+assistant_go_directly_to_third_party_sip_account_login=1
+assistant_third_party_sip_account_domain=apisnix-crm.com
+assistant_third_party_sip_account_transport=udp
+assistant_hide_create_account=1
+disable_chat_feature=1
+disable_meetings_feature=1
 
 [video]
 auto_resize_preview_to_keep_ratio=1
 max_conference_size=vga
-other_display_mode=Hybrid
\ No newline at end of file
+other_display_mode=Hybrid
