# Aucune clé ni mot de passe dans une variable VITE_* : elles sont publiques dans le bundle.
# demo : aucun WebSocket, aucun micro, aucune requête vers le PBX.
VITE_APP_MODE=demo
# Informations publiques de connexion, à récupérer dans la fiche privée pour le pilote.
VITE_SIP_DOMAIN=
VITE_SIP_WSS_URL=
# Facultatif : URL STUN séparées par des virgules, sans identifiants. Vide = réglage par défaut de SIP.js.
VITE_ICE_SERVERS=
# Facultatif : page du serveur web du PBX indiquant si le site est bloqué après trop de refus de connexion.
# Vide = https://<VITE_SIP_DOMAIN>/agc/apisnix/etat-telephonie.php ; son origine doit être dans la CSP connect-src.
VITE_BLOCK_STATUS_URL=
# Accès aux enregistrements (API agent de la supervision). Vide = /api sur la même origine, servi par le reverse proxy.
# Une autre origine doit être autorisée par la CSP connect-src et media-src de l'hébergement.
VITE_RECORDINGS_URL=
# Transfert : non implémenté, à activer seulement après essai réel.
VITE_ENABLE_TRANSFER=false
